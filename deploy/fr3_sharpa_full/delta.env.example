# Full-finetune, 30 Hz, 58D: arm delta relative to chunk-start state; hands absolute.
if [[ -z "${SHARPA_FULL_DELTA_CHECKPOINT:-}" ]]; then export SHARPA_FULL_DELTA_CHECKPOINT=/absolute/path/to/delta_checkpoint/4000; fi
if [[ -z "${SHARPA_FULL_DELTA_PORT:-}" ]]; then export SHARPA_FULL_DELTA_PORT=18767; fi
# Optional external matching statistics; otherwise use the checkpoint-owned file.
# export SHARPA_FULL_DELTA_NORM_STATS=/absolute/path/to/norm_stats.json
