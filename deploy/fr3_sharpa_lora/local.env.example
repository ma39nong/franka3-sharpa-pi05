# Copy to .deployment/lora.env after the new checkpoint is available.
# Set the path of the 30 Hz / 58D / absolute LoRA model.
export SHARPA_LORA_CHECKPOINT=/absolute/path/to/new_lora_step
export SHARPA_LORA_PORT=18766
# Optional: stats are automatically selected from this checkpoint's assets/.
# export SHARPA_LORA_NORM_STATS=/absolute/path/to/matching/norm_stats.json
# export SHARPA_LORA_EXECUTION_TRACE_DIR=/absolute/path/to/lora_execution_traces
